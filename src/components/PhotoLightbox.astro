<div
  id="photo-lightbox"
  class="fixed inset-0 z-[100] hidden overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Visor de fotos"
>
  <button
    type="button"
    data-lightbox-close
    class="absolute inset-0 z-0 cursor-zoom-out bg-stone-950/95"
    aria-label="Cerrar"
  />
  <div
    class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center px-3 pt-[max(3.5rem,env(safe-area-inset-top))] pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:px-6 sm:py-16"
  >
    <div
      class="pointer-events-auto flex max-h-full min-h-0 w-full min-w-0 max-w-full flex-col items-center justify-center overflow-y-auto overscroll-contain"
    >
      <p
        data-lightbox-counter
        class="relative z-10 mb-2 hidden text-center text-sm text-white/80"
        aria-live="polite"
      ></p>
      <img
        data-lightbox-image
        src=""
        alt=""
        class="relative z-10 mx-auto mt-0 h-auto w-auto max-w-full object-contain px-1 max-h-[min(72svh,calc(100dvh-10rem))] sm:max-h-[min(85vh,calc(100dvh-7rem))] sm:px-0"
      />
    </div>
  </div>

  <button
    type="button"
    data-lightbox-close
    class="absolute right-2 top-[max(0.5rem,env(safe-area-inset-top))] z-30 min-h-[44px] touch-manipulation rounded-full bg-white/15 px-4 py-2.5 text-sm font-medium text-white shadow-sm backdrop-blur-sm transition hover:bg-white/25 sm:right-4 sm:top-5"
  >
    Cerrar
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="absolute z-30 hidden touch-manipulation rounded-full bg-white/15 p-3 text-white shadow-sm backdrop-blur-sm transition hover:bg-white/25 disabled:pointer-events-none disabled:opacity-35 bottom-[max(6rem,env(safe-area-inset-bottom))] left-3 top-auto sm:bottom-auto sm:left-[max(0.5rem,env(safe-area-inset-left))] sm:top-1/2 sm:-translate-y-1/2"
    aria-label="Foto anterior"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-7 sm:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button
    type="button"
    data-lightbox-next
    class="absolute z-30 hidden touch-manipulation rounded-full bg-white/15 p-3 text-white shadow-sm backdrop-blur-sm transition hover:bg-white/25 disabled:pointer-events-none disabled:opacity-35 bottom-[max(6rem,env(safe-area-inset-bottom))] right-3 top-auto sm:bottom-auto sm:right-[max(0.5rem,env(safe-area-inset-right))] sm:top-1/2 sm:-translate-y-1/2"
    aria-label="Foto siguiente"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-7 sm:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>

<script>
  const lightbox = document.getElementById("photo-lightbox");
  const lightboxImg = document.querySelector("[data-lightbox-image]");
  const prevBtn = document.querySelector("[data-lightbox-prev]");
  const nextBtn = document.querySelector("[data-lightbox-next]");
  const counterEl = document.querySelector("[data-lightbox-counter]");

  /** @type {{ src: string; alt: string }[]} */
  let gallery = [];
  let index = 0;
  /** @type {number | null} */
  let touchStartX = null;

  function isOpen() {
    return lightbox?.classList.contains("block") ?? false;
  }

  function showAt(i) {
    if (!lightboxImg || !gallery.length) return;
    index = Math.max(0, Math.min(i, gallery.length - 1));
    const item = gallery[index];
    lightboxImg.src = item.src;
    lightboxImg.alt = item.alt;

    const multi = gallery.length > 1;
    prevBtn?.classList.toggle("hidden", !multi);
    nextBtn?.classList.toggle("hidden", !multi);
    counterEl?.classList.toggle("hidden", !multi);
    if (multi && counterEl) {
      counterEl.textContent = `${index + 1} / ${gallery.length}`;
    }
    if (prevBtn instanceof HTMLButtonElement) {
      prevBtn.disabled = index === 0;
    }
    if (nextBtn instanceof HTMLButtonElement) {
      nextBtn.disabled = index >= gallery.length - 1;
    }
  }

  function openLightboxFromTrigger(trigger) {
    if (!lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
    const triggers = [...document.querySelectorAll("[data-lightbox-open]")];
    const i = triggers.indexOf(trigger);
    index = i >= 0 ? i : 0;
    gallery = triggers.map((t) => ({
      src: t.dataset.src ?? "",
      alt: t.dataset.alt ?? "",
    }));
    if (!gallery.length || !gallery[index]?.src) return;

    showAt(index);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("block");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("block");
    lightbox.setAttribute("aria-hidden", "true");
    lightboxImg.removeAttribute("src");
    lightboxImg.alt = "";
    gallery = [];
    index = 0;
    counterEl?.classList.add("hidden");
    if (counterEl) counterEl.textContent = "";
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const t = e.target instanceof Element ? e.target : null;

    if (isOpen()) {
      const prev = t?.closest("[data-lightbox-prev]");
      if (prev instanceof HTMLButtonElement && !prev.disabled) {
        e.preventDefault();
        showAt(index - 1);
        return;
      }
      const next = t?.closest("[data-lightbox-next]");
      if (next instanceof HTMLButtonElement && !next.disabled) {
        e.preventDefault();
        showAt(index + 1);
        return;
      }
    }

    const openBtn = t?.closest("[data-lightbox-open]");
    if (openBtn instanceof HTMLElement) {
      const src = openBtn.dataset.src;
      if (src) openLightboxFromTrigger(openBtn);
      return;
    }

    const closeBtn = t?.closest("[data-lightbox-close]");
    if (closeBtn) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (!isOpen()) return;
    if (e.key === "Escape") {
      closeLightbox();
      return;
    }
    if (gallery.length <= 1) return;
    if (e.key === "ArrowLeft") {
      e.preventDefault();
      if (index > 0) showAt(index - 1);
      return;
    }
    if (e.key === "ArrowRight") {
      e.preventDefault();
      if (index < gallery.length - 1) showAt(index + 1);
    }
  });

  lightbox?.addEventListener(
    "touchstart",
    (e) => {
      if (!isOpen() || gallery.length <= 1) return;
      touchStartX = e.changedTouches[0]?.screenX ?? null;
    },
    { passive: true }
  );

  lightbox?.addEventListener(
    "touchend",
    (e) => {
      if (touchStartX == null || !isOpen() || gallery.length <= 1) return;
      const endX = e.changedTouches[0]?.screenX;
      if (endX == null) return;
      const dx = endX - touchStartX;
      touchStartX = null;
      if (Math.abs(dx) < 56) return;
      if (dx > 0 && index > 0) showAt(index - 1);
      else if (dx < 0 && index < gallery.length - 1) showAt(index + 1);
    },
    { passive: true }
  );
</script>
