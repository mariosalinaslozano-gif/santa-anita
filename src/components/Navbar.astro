---
const links = [
  { href: "#quienes-somos", label: "Quiénes Somos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#instalaciones", label: "Instalaciones" }
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm shadow-sm">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 py-3 md:py-4 flex items-center gap-3 sm:gap-4">
    <a href="#" class="group inline-flex items-center rounded-xl border border-transparent bg-white/80 px-3 sm:px-4 py-2 shadow-sm transition-all hover:border-green-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-600/40 shrink-0">
      <img
        src="/LogoSantaAnita.png"
        alt="Casa de Retiro Santa Anita"
        class="h-10 sm:h-11 md:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
      />
    </a>

    <!-- Same links as desktop; scroll horizontally on narrow screens -->
    <div
      class="min-w-0 flex-1 overflow-x-auto overscroll-x-contain [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden flex justify-center"
    >
      <ul class="flex w-max items-center gap-4 sm:gap-6 md:gap-8 py-0.5">
        {links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              class="text-stone-600 hover:text-green-700 transition-colors font-medium text-sm sm:text-base whitespace-nowrap"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <a
      href="#contacto"
      class="shrink-0 bg-green-700 text-white px-3 sm:px-5 py-2 rounded-full text-sm font-medium hover:bg-green-800 transition-colors"
    >
      Contáctanos
    </a>
  </nav>
</header>

<!-- Offset so content doesn't hide behind fixed navbar -->
<div class="h-16"></div>
