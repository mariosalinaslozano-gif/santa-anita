---
const links = [
  { href: "#quienes-somos", label: "Quiénes Somos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#instalaciones", label: "Instalaciones" }
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm shadow-sm">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 py-3 md:py-4 flex items-center gap-3 sm:gap-4">
    <a
      href="/"
      data-nav-logo
      class="group inline-flex touch-manipulation items-center rounded-xl border border-transparent bg-white/80 px-3 sm:px-4 py-2 shadow-sm transition-all hover:border-green-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-600/40 shrink-0"
    >
      <img
        src="/Images/LogoSantaAnita.png"
        alt="Casa de Retiro Santa Anita"
        class="h-10 sm:h-11 md:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
      />
    </a>

    <!-- Desktop: inline links -->
    <div class="hidden md:flex flex-1 justify-center min-w-0">
      <ul class="flex items-center gap-8">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-stone-600 hover:text-green-700 transition-colors font-medium"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-1 items-center justify-end gap-2 md:flex-none">
      <!-- Mobile: dropdown menu -->
      <details class="relative md:hidden group" data-mobile-nav>
        <summary
          class="list-none min-h-[44px] min-w-[44px] cursor-pointer touch-manipulation inline-flex items-center justify-center gap-2 rounded-lg border border-stone-200 bg-white px-3 py-2 text-sm font-medium text-stone-700 shadow-sm transition-colors hover:border-green-200 hover:bg-stone-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-600/40 [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Abrir menú de secciones</span>
          <svg class="h-5 w-5 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span>Menú</span>
        </summary>
        <div
          class="absolute right-0 top-full z-50 mt-2 min-w-[14rem] overflow-hidden rounded-xl border border-stone-200 bg-white py-2 shadow-lg ring-1 ring-black/5"
        >
          <ul class="flex flex-col">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-4 py-3 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-50 hover:text-green-700"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>

      <a
        href="#contacto"
        class="inline-flex min-h-[44px] shrink-0 touch-manipulation items-center justify-center bg-green-700 px-3 sm:px-5 py-2 text-sm font-medium text-white rounded-full hover:bg-green-800 transition-colors"
      >
        Contáctanos
      </a>
    </div>
  </nav>
</header>

<!-- Offset so content doesn't hide behind fixed navbar -->
<div class="h-16"></div>

<script>
  /** Logo on home: smooth scroll to top (not an instant jump). Other pages: normal navigation to /. */
  document.addEventListener("click", (e) => {
    const logo = e.target instanceof Element ? e.target.closest("[data-nav-logo]") : null;
    if (logo instanceof HTMLAnchorElement) {
      const path = window.location.pathname.replace(/\/+$/, "") || "/";
      if (path === "/") {
        e.preventDefault();
        const instant = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: instant ? "auto" : "smooth" });
        if (window.location.hash) {
          history.replaceState(null, "", window.location.pathname + window.location.search);
        }
      }
    }
  });

  /** Close mobile menu: section link, click outside, or Escape. */
  document.addEventListener("click", (e) => {
    const details = document.querySelector("details[data-mobile-nav]");
    if (!(details instanceof HTMLDetailsElement) || !details.open) return;

    const target = e.target;
    if (!(target instanceof Node)) return;

    if (!details.contains(target)) {
      details.removeAttribute("open");
      return;
    }

    const a = target instanceof Element ? target.closest('a[href^="#"]') : null;
    if (a && details.contains(a)) details.removeAttribute("open");
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelector("details[data-mobile-nav][open]")?.removeAttribute("open");
  });
</script>
